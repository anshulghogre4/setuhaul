{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventBridgeRulesAssumeThisRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "events.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "118490268011"
        }
      }
    }
  ]
}
