{
  "ServiceName": "setuhaul-api",
  "SourceConfiguration": {
    "AutoDeploymentsEnabled": false,
    "ImageRepository": {
      "ImageIdentifier": "118490268011.dkr.ecr.us-east-1.amazonaws.com/setuhaul-api:latest",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "8000",
        "RuntimeEnvironmentVariables": {
          "AGENTCORE_RUNTIME_ARN": ""
        }
      }
    }
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/health/live",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB"
  }
}
