# SetuHaul environment template — copy to `.env` (never commit real secrets).
# Hosted project URL (public): https://kujffzgqjmqphkmrbawy.supabase.co

# --- Required for Sprint 1 ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Backend only — never put SERVICE_ROLE in the browser or commit it
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_JWT_AUDIENCE=authenticated

# Backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: extra exact origins (production Vercel URL) comma-separated.
# Default regex also allows https://*.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Leave blank on laptop and on first hosted BFF. Set only after AgentCore deploy.
AGENTCORE_RUNTIME_ARN=
# Compute must share a region with Postgres and Redis (SOLUTION_DESIGN.md Appendix A).
# Startup fails if the resolved region is not ap-south-1; ALLOW_REGION_MISMATCH=true
# accepts the cross-region latency on purpose and logs CRITICAL instead.
AWS_REGION=ap-south-1
ALLOW_REGION_MISMATCH=false

# M8 expiry sweeper (SOLUTION_DESIGN.md D2/D9, TECH_STACK.md §5).
# JOB_AUTH_TOKEN is the shared secret POST /internal/jobs/expiry-sweep requires in the
# X-SetuHaul-Job-Token header — the value an EventBridge connection holds as its API key.
# Blank means the endpoint returns 503 and sweeps nothing (fail closed, on purpose).
JOB_AUTH_TOKEN=
# public.users.user_id the sweeper attributes its audit_logs rows to. audit_logs.user_id is a
# NOT NULL FK to users, so an automated transition still needs a real row. Use a dedicated
# service account, not a human planner's id. Blank means the endpoint returns 503.
JOB_ACTOR_USER_ID=
PENDING_CONFIRMATION_TTL_MINUTES=15
HELD_SLOT_TTL_SECONDS=90
EXPIRY_SWEEP_BATCH_LIMIT=50

# Frontend (Vite) — public anon key only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_API_BASE_URL=http://localhost:8000

# --- Sprint 2+ (live chat / Redis memory / optional LangSmith) ---
# Never commit real values. Paste into gitignored `.env` / `.env.local` only.
#
# LLM: Gemini uses ChatGoogleGenerativeAI in Vertex AI mode; OpenAI / OpenRouter use ChatOpenAI.
# LLM_PROVIDER=auto|gemini|openai|openrouter
# auto = first configured provider, in order Gemini -> OpenAI -> OpenRouter (E4.1/issue #31:
#   Gemini/Vertex is the primary provider per TECH_STACK.md D-4; OpenAI is the documented fallback).
# Default Gemini model is gemini-3.7-flash; override with LLM_MODEL when needed.
#
# Gemini is served from Vertex AI (asia-south1/Mumbai), NOT the Gemini Developer API -- credentials
# are GCP Application Default Credentials (ADC: a service account key file, workload identity, or
# `gcloud auth application-default login`), resolved from the environment, not a key this app holds.
# GCP_PROJECT being set is what "Gemini is configured" means; GOOGLE_API_KEY alone is no longer
# sufficient (it was the old Developer-API path, which Google's own docs warn can silently route
# through the global endpoint regardless of configured location -- exactly what asia-south1 exists
# to avoid). GCP_VERTEX_LOCATION defaults to asia-south1; changing it is a deliberate accepted
# latency/residency tradeoff, not a typo-tolerant field.
LLM_PROVIDER=auto
LLM_MODEL=
GCP_PROJECT=
GCP_VERTEX_LOCATION=asia-south1
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Deprecated: the old Gemini Developer API key path. No longer read by resolve_llm/build_chat_model
# (see GCP_PROJECT above). Left declared only so a stale local .env doesn't break settings load.
GOOGLE_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=setuhaul-agentcore
# When LANGSMITH_TRACING=true and LANGSMITH_API_KEY is set, the assistant
# enables LangSmith/LangChain tracing for invoke + tool loops (sanitized payloads).
# Backend loads these from repo-root `.env` / `.env.local` via pydantic-settings.

# --- Shared POC demo accounts (seeded in Supabase Auth) ---
# Passwords: owner shares privately / fill locally — never commit real passwords.
SETUHAUL_POC_DRIVER_EMAIL=ravi.kumar@setuhaul.com
SETUHAUL_POC_DRIVER_PASSWORD=
SETUHAUL_POC_OPERATOR_EMAIL=priya.mehta@setuhaul.com
SETUHAUL_POC_OPERATOR_PASSWORD=
SETUHAUL_POC_ADMIN_EMAIL=admin@setuhaul.com
SETUHAUL_POC_ADMIN_PASSWORD=
