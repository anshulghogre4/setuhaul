# SetuHaul environment template — copy to `.env` (never commit real secrets).
# Hosted project URL (public): https://kujffzgqjmqphkmrbawy.supabase.co

# --- Required for Sprint 1 ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Backend only — never put SERVICE_ROLE in the browser or commit it
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_JWT_AUDIENCE=authenticated

# Backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) — public anon key only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
VITE_API_BASE_URL=http://localhost:8000

# --- Sprint 2+ (not required for Sprint 1 walking skeleton) ---
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
