# --- Sprint 2+ (live chat / Redis memory / optional LangSmith) ---
# Never commit real values. Paste into gitignored `.env` / `.env.local` only.
#
# LLM: OpenAI / OpenRouter use ChatOpenAI; Gemini uses ChatGoogleGenerativeAI.
# LLM_PROVIDER=auto|openai|openrouter|gemini
# auto = first configured key in order OpenAI → OpenRouter → Gemini.
# GOOGLE_API_KEY must be a Google AI Studio / Gemini API key, not an OpenAI sk-proj key.
# Default Gemini model is gemini-2.5-flash (gemini-2.0-flash shut down 2026-06-01).
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# When LANGSMITH_TRACING=true and LANGSMITH_API_KEY is set, the assistant
# enables LangSmith/LangChain tracing for invoke + tool loops (sanitized payloads).
# Backend loads these from repo-root `.env` / `.env.local` via pydantic-settings.

# --- Shared POC demo accounts (seeded in Supabase Auth) ---
