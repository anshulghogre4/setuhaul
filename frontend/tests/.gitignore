# Generated per-role storageState files. Each one contains a REAL Supabase access token and
# refresh token for a POC account -- they must never reach git. Regenerated by the `setup`
# project on every run (`tests/auth.setup.ts`), so nothing is lost by ignoring them.
#
# Scoped here rather than in `frontend/.gitignore` deliberately: this directory owns the files,
# and a nested ignore keeps the rule next to the thing it protects.
.auth/

# Per-run Playwright output: traces and failure screenshots (`outputDir` in playwright.config.ts
# points here on purpose, so one ignore file covers everything this suite generates).
.artifacts/
